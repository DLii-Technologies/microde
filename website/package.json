{
	"name": "@microde/docs",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "pnpm run docs:api && docusaurus build",
		"clean": "docusaurus clear && node scripts/clean-generated.mjs",
		"docs:api": "node scripts/clean-generated.mjs && typedoc --options typedoc.json",
		"start": "pnpm run docs:api && docusaurus start",
		"serve": "docusaurus serve",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@docusaurus/core": "^3.10.2",
		"@docusaurus/faster": "^3.10.2",
		"@docusaurus/preset-classic": "^3.10.2",
		"@mdx-js/react": "^3.1.1",
		"clsx": "^2.1.1",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@docusaurus/module-type-aliases": "^3.10.2",
		"@docusaurus/tsconfig": "^3.10.2",
		"@docusaurus/types": "^3.10.2",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.3",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^6.0.3"
	}
}
