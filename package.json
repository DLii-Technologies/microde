{
	"name": "microde",
	"description": "The Microde framework for building composable applications.",
	"license": "MIT",
	"author": "DLii Technologies",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"build": "pnpm -r build",
		"docs:api": "pnpm --dir website docs:api",
		"docs:build": "pnpm --dir website build",
		"docs:clean": "pnpm --dir website clean",
		"docs:dev": "pnpm --dir website start",
		"docs:serve": "pnpm --dir website serve",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "pnpm -r typecheck",
		"sampo": "sampo",
		"release:prepare": "sampo release",
		"release": "sampo publish"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.10",
		"prettier": "^3.9.6",
		"sampo": "^0.20.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
