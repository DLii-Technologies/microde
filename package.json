{
	"name": "microde",
	"version": "0.0.1",
	"description": "The Microde framework for building composable microservices.",
	"license": "MIT",
	"author": "DLii Technologies",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"build": "pnpm -r build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "pnpm -r typecheck",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.10",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
